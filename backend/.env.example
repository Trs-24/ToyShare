# Database
DATABASE_URL="postgresql://user:password@localhost:5432/toyshare?sslmode=prefer"

# JWT Authentication (REQUIRED — app will fail without this)
JWT_SECRET=your-secure-jwt-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP (email sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@toyshare.app

# Backend Server Port (3001 to avoid conflict with Next.js on 3000)
PORT=3001

# Frontend URL (used for CORS, email links, OAuth redirects)
FRONTEND_URL=http://localhost:3000
